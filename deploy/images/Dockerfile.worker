# The ingestion worker

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /usr/local/bin/uv

LABEL org.opencontainers.image.title="Primer Ingestion Worker" \
      org.opencontainers.image.description="Parses, chunks, and indexes documents" \
      org.opencontainers.image.source="https://github.com/isaiah-harville/Primer" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV UV_COMPILE_BYTECODE=1 \
    HAYSTACK_TELEMETRY_ENABLED=False \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/var/cache/primer/huggingface

RUN groupadd --gid 10001 primer \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin primer

WORKDIR /app

COPY pyproject.toml uv.lock ./

COPY services/control-api/pyproject.toml services/control-api/
COPY services/retrieval/pyproject.toml services/retrieval/
COPY services/chat/pyproject.toml services/chat/
COPY packages/ packages/
COPY services/ingestion/ services/ingestion/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --package primer-ingestion \
    && mkdir -p /var/cache/primer/huggingface \
    && chown -R 10001:10001 /app /var/cache/primer

USER 10001:10001
CMD ["celery", "-A", "primer_ingestion.worker", "worker", "--loglevel", "info"]
