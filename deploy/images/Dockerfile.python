# The API services: Control, Chat, and Retrieval.
#
# Single stage on purpose. A build/runtime split earns its keep when the
# build needs compilers, caches, or a package manager the runtime should not
# have. None of that applies here: every dependency installs from a wheel,
# uv's cache is a mount rather than a layer, and the runtime base would be
# the same image anyway. Splitting would add a stage and copy the same files
# into it.
#
# Deliberately excludes the ingestion worker. Docling needs torch, torch
# publishes no musl wheels, and carrying it would mean a multi-gigabyte
# image for three services that never import it. The worker has its own
# Dockerfile for that reason.
#
# Which service runs is chosen by the command, so Compose can pin all three
# to one digest and know they are the same code.

FROM ghcr.io/astral-sh/uv:python3.13-alpine

# The published python+uv tags lag uv itself by several minor versions, so
# the pinned binary is copied over whatever the tag shipped with.
COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /usr/local/bin/uv

LABEL org.opencontainers.image.title="Primer API" \
      org.opencontainers.image.description="Control, Chat, and Retrieval services" \
      org.opencontainers.image.source="https://github.com/isaiah-harville/Primer" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# A numeric non-root user with a real passwd entry: the id has to be stable
# for volume ownership, and a bare `USER 10001` breaks anything that looks
# itself up.
RUN addgroup -g 10001 primer \
    && adduser -u 10001 -G primer -s /sbin/nologin -D primer

WORKDIR /app

# One sync, after everything is copied. Splitting it into a dependency
# layer and a workspace layer looks like better caching, but each `uv sync`
# writes a complete virtualenv, and the first one stays in its layer - it
# nearly doubled this image. The uv cache mount already makes a rebuild
# cheap without leaving a second copy behind.
COPY pyproject.toml uv.lock ./
COPY packages/ packages/
COPY services/control-api/ services/control-api/
COPY services/ingestion/pyproject.toml services/ingestion/
COPY services/retrieval/ services/retrieval/
COPY services/chat/ services/chat/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --group server \
      --package primer-control --package primer-chat --package primer-retrieval \
    && chown -R 10001:10001 /app

USER 10001:10001
EXPOSE 8000
CMD ["python", "-c", "raise SystemExit('specify a service command')"]
