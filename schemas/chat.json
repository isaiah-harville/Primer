{
  "components": {
    "schemas": {
      "AskRequest": {
        "additionalProperties": false,
        "description": "A question, and the library it is asked of, if any.\n\nWithout a library the question is answered by the model rather than from\nthe user's documents, and the answer carries no citations.",
        "properties": {
          "library_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Library Id"
          },
          "message": {
            "maxLength": 32000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          }
        },
        "required": [
          "message"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "ChatModel": {
        "additionalProperties": false,
        "description": "One model a user may pick between.\n\nNamed separately from the provider's own listing: an endpoint serves what\nit serves, and this is the subset an operator decided to offer.",
        "properties": {
          "default": {
            "default": false,
            "title": "Default",
            "type": "boolean"
          },
          "id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "title": "ChatModel",
        "type": "object"
      },
      "ChatModelList": {
        "additionalProperties": false,
        "description": "What this deployment can answer with, and whether it could be asked.\n\nAn empty list with `endpoint_reachable` false is not the same fact as an\nempty list with it true, and the difference is the whole point of the\nfield. Primer used to answer an unreachable endpoint with its configured\ndefault name, which put a model in the picker that nothing was serving:\nthe interface offered a choice that did not exist and the failure only\nsurfaced when someone asked a question and waited for an answer that was\nnever coming.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "endpoint_reachable": {
            "default": true,
            "title": "Endpoint Reachable",
            "type": "boolean"
          },
          "models": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ChatModel"
            },
            "title": "Models",
            "type": "array"
          }
        },
        "title": "ChatModelList",
        "type": "object"
      },
      "Citation": {
        "additionalProperties": false,
        "description": "A grounded reference from an assistant response to a source passage.\n\nCitations address an immutable document version so a later replacement\ncannot silently change what an existing answer claimed to cite.",
        "properties": {
          "chunk_id": {
            "format": "uuid",
            "title": "Chunk Id",
            "type": "string"
          },
          "document_id": {
            "format": "uuid",
            "title": "Document Id",
            "type": "string"
          },
          "document_version_id": {
            "format": "uuid",
            "title": "Document Version Id",
            "type": "string"
          },
          "excerpt": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Excerpt"
          },
          "locator": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceLocator"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "document_id",
          "document_version_id",
          "chunk_id"
        ],
        "title": "Citation",
        "type": "object"
      },
      "ConversationSummary": {
        "additionalProperties": false,
        "description": "A conversation, which belongs to one person and at most one library.\n\nA conversation with no library is ungrounded for its whole length: the\nlibrary is fixed when it starts, so citations in one turn and none in the\nnext cannot happen within a single thread.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "library_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Library Id"
          },
          "owner_user_id": {
            "format": "uuid",
            "title": "Owner User Id",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "owner_user_id",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "ConversationSummary",
        "type": "object"
      },
      "FollowUpRequest": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "maxLength": 32000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "model": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          }
        },
        "required": [
          "message"
        ],
        "title": "FollowUpRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MessageRole": {
        "enum": [
          "user",
          "assistant"
        ],
        "title": "MessageRole",
        "type": "string"
      },
      "MessageState": {
        "description": "A message is always in exactly one of these.\n\n`STREAMING` is the only non-terminal state. A message left in it is a\nstream that died, which is a recoverable fault rather than an answer, and\nis distinguishable from one that genuinely failed.",
        "enum": [
          "streaming",
          "completed",
          "failed",
          "cancelled"
        ],
        "title": "MessageState",
        "type": "string"
      },
      "MessageSummary": {
        "additionalProperties": false,
        "description": "One turn, and what it was grounded in.\n\nCitations are stored with the message rather than recomputed, because\nwhat an answer cited is a fact about that answer. Re-retrieving later\nwould produce today's passages for yesterday's words.\n\nContent keeps its whitespace, like `MessageDelta`, so that concatenating\na stream's fragments yields exactly the stored answer. Trimming here\nwould make the two disagree for any answer that begins or ends with\nspace, and a client comparing them would be right to think it had lost\nsomething.",
        "properties": {
          "citations": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          },
          "content": {
            "title": "Content",
            "type": "string"
          },
          "conversation_id": {
            "format": "uuid",
            "title": "Conversation Id",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error_code": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "provider_model": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Model"
          },
          "role": {
            "$ref": "#/components/schemas/MessageRole"
          },
          "state": {
            "$ref": "#/components/schemas/MessageState"
          }
        },
        "required": [
          "id",
          "conversation_id",
          "role",
          "state",
          "content",
          "created_at"
        ],
        "title": "MessageSummary",
        "type": "object"
      },
      "SourceLocator": {
        "additionalProperties": false,
        "description": "Where a passage sits inside its source document.\n\nLocators are user-meaningful positions only. Filesystem or object-store\npaths are deliberately absent from citation-facing contracts.",
        "properties": {
          "page": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "section": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          }
        },
        "title": "SourceLocator",
        "type": "object"
      },
      "ToolCallSummary": {
        "additionalProperties": false,
        "description": "One tool call, and what was decided about it.\n\nArguments are shown to the user because they are what is being consented\nto: approving \"run a command\" without seeing the command is not consent.\nThey are sanitized before they get here.",
        "properties": {
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          },
          "conversation_id": {
            "format": "uuid",
            "title": "Conversation Id",
            "type": "string"
          },
          "decided_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided At"
          },
          "decided_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decided By"
          },
          "duration_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "error_code": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "output": {
            "anyOf": [
              {
                "maxLength": 8000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          },
          "phase": {
            "$ref": "#/components/schemas/ToolPhase"
          },
          "requested_at": {
            "format": "date-time",
            "title": "Requested At",
            "type": "string"
          },
          "server_name": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Server Name",
            "type": "string"
          },
          "tool_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Tool Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "conversation_id",
          "tool_name",
          "server_name",
          "phase",
          "requested_at",
          "expires_at"
        ],
        "title": "ToolCallSummary",
        "type": "object"
      },
      "ToolPhase": {
        "description": "The stages a tool call passes through, as a client sees them.",
        "enum": [
          "requested",
          "approved",
          "denied",
          "running",
          "completed",
          "failed",
          "expired"
        ],
        "title": "ToolPhase",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Cited, streamed answers grounded in a user's own library",
    "title": "Primer Chat",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/conversations": {
      "get": {
        "operationId": "list_conversations_api_v1_conversations_get",
        "parameters": [
          {
            "in": "query",
            "name": "library_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Library Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ConversationSummary"
                  },
                  "title": "Response List Conversations Api V1 Conversations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List the caller's conversations",
        "tags": [
          "chat"
        ]
      },
      "post": {
        "description": "Start a conversation and stream its first answer.\n\nThe library is authorized inside the stream rather than before it, so a\nforbidden library ends as a terminal `error` event on an open stream. A\n404 here would be equally correct; the stream is chosen so a client has\nexactly one place to handle failures.",
        "operationId": "ask_api_v1_conversations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask a question and stream the answer",
        "tags": [
          "chat"
        ]
      }
    },
    "/api/v1/conversations/{conversation_id}": {
      "delete": {
        "description": "Remove a conversation and everything written in it.\n\nReally removed, not hidden. A conversation is what someone asked and what\nthey were told, and a user who deletes one is usually deleting it for a\nreason rather than tidying a list. The messages and their citations go\nwith it, by the cascade the schema already declares.\n\nOwnership is in the query, so another user's conversation is not found\nrather than forbidden: whether it exists is not this caller's business.",
        "operationId": "delete_conversation_api_v1_conversations__conversation_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete a conversation",
        "tags": [
          "chat"
        ]
      },
      "get": {
        "operationId": "read_conversation_api_v1_conversations__conversation_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read one conversation",
        "tags": [
          "chat"
        ]
      }
    },
    "/api/v1/conversations/{conversation_id}/messages": {
      "get": {
        "operationId": "list_messages_api_v1_conversations__conversation_id__messages_get",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MessageSummary"
                  },
                  "title": "Response List Messages Api V1 Conversations  Conversation Id  Messages Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read a conversation's turns",
        "tags": [
          "chat"
        ]
      },
      "post": {
        "description": "Ask another question in an existing conversation.\n\nOwnership is part of the lookup, so a stranger who knows or guesses the\nid gets the same 404 as for a conversation that does not exist - and\ngets it before Retrieval or the model is touched.",
        "operationId": "follow_up_api_v1_conversations__conversation_id__messages_post",
        "parameters": [
          {
            "in": "path",
            "name": "conversation_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Conversation Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FollowUpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Continue a conversation",
        "tags": [
          "chat"
        ]
      }
    },
    "/api/v1/models": {
      "get": {
        "description": "What a user may choose between: everything the chat endpoint serves.\n\nAsked live rather than kept as a list of Primer's own, so a model added\nor removed on the endpoint shows up here without redeploying Primer to\nmatch.",
        "operationId": "list_models_api_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatModelList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Models this deployment offers",
        "tags": [
          "chat"
        ]
      }
    },
    "/api/v1/tool-requests": {
      "get": {
        "operationId": "list_requests_api_v1_tool_requests_get",
        "parameters": [
          {
            "in": "query",
            "name": "conversation_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Conversation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ToolCallSummary"
                  },
                  "title": "Response List Requests Api V1 Tool Requests Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List pending tool requests",
        "tags": [
          "tools"
        ]
      }
    },
    "/api/v1/tool-requests/{request_id}/approve": {
      "post": {
        "operationId": "approve_api_v1_tool_requests__request_id__approve_post",
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Request Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolCallSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Approve a tool call",
        "tags": [
          "tools"
        ]
      }
    },
    "/api/v1/tool-requests/{request_id}/deny": {
      "post": {
        "operationId": "deny_api_v1_tool_requests__request_id__deny_post",
        "parameters": [
          {
            "in": "path",
            "name": "request_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Request Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolCallSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Deny a tool call",
        "tags": [
          "tools"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
