# The SvelteKit front end, built once and served as a Node adapter output.

FROM node:22-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
RUN --mount=type=cache,target=/pnpm/store pnpm install --frozen-lockfile

COPY apps/web/ apps/web/
RUN pnpm --filter @primer/web build \
    && pnpm --filter @primer/web --prod deploy /app/bundle


FROM node:22-bookworm-slim AS runtime

LABEL org.opencontainers.image.title="Primer Web" \
      org.opencontainers.image.source="https://github.com/isaiah-harville/Primer" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV NODE_ENV=production
WORKDIR /app

COPY --from=build --chown=node:node /app/apps/web/build ./build
COPY --from=build --chown=node:node /app/bundle/node_modules ./node_modules

# node:22 ships a `node` user at uid 1000; using it avoids a passwd entry
# that does not exist, which breaks anything calling getpwuid.
USER node

EXPOSE 3000
CMD ["node", "build/index.js"]
