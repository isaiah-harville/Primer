{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!**/.svelte-kit",
			"!**/build",
			"!**/node_modules",
			"!**/*.svelte",
			"!apps/web/src/app.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": { "preset": "recommended" }
	},
	"javascript": {
		"formatter": { "quoteStyle": "single", "semicolons": "always" }
	}
}
