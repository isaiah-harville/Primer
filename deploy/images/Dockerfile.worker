# The ingestion worker.
#
# Separate from the API image, and on Debian rather than Alpine, for one
# reason: Docling's layout models run on torch, and torch publishes only
# glibc wheels. Keeping this apart is what lets the three API services stay
# small instead of every one of them carrying a machine-learning stack.
#
# Single stage, for the same reason as the API image: nothing is compiled
# here, so there is nothing a second stage would leave behind.

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /usr/local/bin/uv

LABEL org.opencontainers.image.title="Primer Ingestion Worker" \
      org.opencontainers.image.description="Parses, chunks, and indexes documents" \
      org.opencontainers.image.source="https://github.com/isaiah-harville/Primer" \
      org.opencontainers.image.licenses="Apache-2.0"

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HOME=/var/cache/primer/huggingface

RUN groupadd --gid 10001 primer \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin primer

WORKDIR /app

# One sync, after everything is copied. Each `uv sync` writes a complete
# virtualenv and the first one stays in its layer, so a separate dependency
# layer costs more than it saves - and with torch in the graph that cost is
# measured in gigabytes. The uv cache mount keeps rebuilds cheap.
COPY pyproject.toml uv.lock ./
# Every workspace member's manifest, even the ones not installed: uv
# resolves the whole workspace, and a missing member makes the lock look
# stale.
COPY services/control-api/pyproject.toml services/control-api/
COPY services/retrieval/pyproject.toml services/retrieval/
COPY services/chat/pyproject.toml services/chat/
COPY packages/ packages/
COPY services/ingestion/ services/ingestion/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --package primer-ingestion \
    && mkdir -p /var/cache/primer/huggingface \
    && chown -R 10001:10001 /app /var/cache/primer

USER 10001:10001
CMD ["celery", "-A", "primer_ingestion.worker", "worker", "--loglevel", "info"]
